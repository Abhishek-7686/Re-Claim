{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "env": {
        "browser": true,
        "es2022": true
    },
    "plugins": ["react", "react-hooks"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn"
    },
    "ignorePatterns": ["dist", "node_modules"]
}
